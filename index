  <text x="270" y="247" class="header-text">Date</text>
  <text x="420" y="247" class="header-text">Test Type</text>
  <text x="610" y="247" class="header-text">Subject</text>
  <text x="860" y="247" class="header-text">Registration</text>
  <line x1="180" y1="286" x2="745" y2="286" class="grid-line" />
  <line x1="480" y1="315" x2="745" y2="315" class="grid-line" />
  <line x1="480" y1="344" x2="745" y2="344" class="grid-line" />
  <text x="110" y="274" class="bold-cell" text-anchor="middle">January</text>
