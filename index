/* ================= STORAGE HELPERS ================= */
async function loadProgress(name){
  try{
    const res = await window.storage.get('progress:' + name.toLowerCase(), true);
    return res ? JSON.parse(res.value) : { totalAnswered:0, totalCorrect:0, lessonStats:{}, history:[] };
  }catch(e){
    return { totalAnswered:0, totalCorrect:0, lessonStats:{}, history:[] };
  }
}
async function saveProgress(name, progress){
  try{
    await window.storage.set('progress:' + name.toLowerCase(), JSON.stringify(progress), true);
  }catch(e){ console.error('save failed', e); }
}

/* ================= LOGIN ================= */
async function login(){
  const val = document.getElementById('name-input').value.trim();
  if(!val){ return; }
  currentUser = val;
  userProgress = await loadProgress(currentUser);
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').classList.add('active');
  document.getElementById('user-name-display').textContent = currentUser;
  updateUserStat();
  renderLessons();
  renderTestList('est-old');
  renderTestList('est-new');
  renderTestList('act');
}
function logout(){
  currentUser = null;
  document.getElementById('app').classList.remove('active');
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('name-input').value = '';
}
function updateUserStat(){
  document.getElementById('user-stat-display').textContent =
    userProgress.totalAnswered + ' answered · ' +
    (userProgress.totalAnswered ? Math.round(100*userProgress.totalCorrect/userProgress.totalAnswered) : 0) + '% correct';
}

/* ================= NAV ================= */
function switchView(viewId, btn){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById(viewId).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  if(btn) btn.classList.add('active');
}

/* ================= RENDER LISTS ================= */
function renderLessons(){
  const grid = document.getElementById('lesson-grid');
  grid.innerHTML = '';
  DATA.biologyLessons.forEach(lesson=>{
    const stat = userProgress.lessonStats[lesson.id] || {answered:0, correct:0};
    const pct = stat.answered ? Math.round(100*stat.correct/stat.answered) : 0;
    const card = document.createElement('div');
    card.className = 'lesson-card';
    card.onclick = () => startSet(lesson.questions, lesson.title, lesson.id);
    card.innerHTML = `
      <h3>${lesson.title}</h3>
      <div class="meta">${lesson.questions.length} questions</div>
      <div class="bar"><div class="bar-fill" style="width:${pct}%"></div></div>
    `;
    grid.appendChild(card);
  });
}
function renderTestList(kind){
  let list, containerId;
  if(kind === 'est-old'){ list = DATA.estOldTests; containerId = 'est-old-list'; }
  else if(kind === 'est-new'){ list = DATA.estNewTests; containerId = 'est-new-list'; }
  else { list = DATA.actTests; containerId = 'act-list'; }
  const container = document.getElementById(containerId);
  container.innerHTML = '';
  if(!list || list.length === 0){
    container.innerHTML = `<div class="empty-hint" style="margin-top:0;">Nothing here yet.</div>`;
    return;
  }
  list.forEach(test=>{
    const row = document.createElement('div');
    row.className = 'test-row';
    row.innerHTML = `
      <div>
        <h3>${test.title}</h3>
        <div class="meta">${test.meta}</div>
      </div>
      <button>Start</button>
    `;
    row.querySelector('button').onclick = () => startSet(test.questions, test.title, null);
    container.appendChild(row);
  });
}
function getFilteredLessons(idPrefix){
  return DATA.biologyLessons
    .map(lesson => ({
      id: lesson.id,
      title: lesson.title,
      questions: lesson.questions.filter(q => q.id.startsWith(idPrefix))
    }))
    .filter(lesson => lesson.questions.length > 0)
    .sort((a,b) => b.questions.length - a.questions.length);
}
function renderLessonGrid(gridId, lessons, statPrefix){
  const grid = document.getElementById(gridId);
  grid.innerHTML = '';
  lessons.forEach(lesson=>{
    const statKey = statPrefix + lesson.id;
    const stat = userProgress.lessonStats[statKey] || {answered:0, correct:0};
    const pct = stat.answered ? Math.round(100*stat.correct/stat.answered) : 0;
    const card = document.createElement('div');
    card.className = 'lesson-card';
    card.onclick = () => startSet(lesson.questions, lesson.title, statKey);
    card.innerHTML = `
      <h3>${lesson.title}</h3>
      <div class="meta">${lesson.questions.length} questions</div>
      <div class="bar"><div class="bar-fill" style="width:${pct}%"></div></div>
    `;
    grid.appendChild(card);
  });
}
function renderEstLessons(){
  renderLessonGrid('est-lesson-grid', getFilteredLessons('est-'), 'est::');
}
function renderActLessons(){
  renderLessonGrid('act-lesson-grid', getFilteredLessons('act-'), 'act::');
}
function switchEstSubtab(which, btn){
  document.getElementById('est-old-list').style.display = which === 'est-old' ? 'block' : 'none';
  document.getElementById('est-new-list').style.display = which === 'est-new' ? 'block' : 'none';
  document.getElementById('est-lesson-grid').style.display = which === 'est-lesson' ? 'grid' : 'none';
  if(which === 'est-lesson') renderEstLessons();
  document.querySelectorAll('#est-view .subtab-btn').forEach(b=>{
    b.style.background = 'rgba(244,241,230,0.08)';
    b.classList.remove('active');
  });
  btn.style.background = 'var(--moss)';
  btn.classList.add('active');
}
function switchActSubtab(which, btn){
  document.getElementById('act-list').style.display = which === 'act-all' ? 'block' : 'none';
  document.getElementById('act-lesson-grid').style.display = which === 'act-lesson' ? 'grid' : 'none';
  if(which === 'act-lesson') renderActLessons();
  document.querySelectorAll('#act-view .subtab-btn').forEach(b=>{
    b.style.background = 'rgba(244,241,230,0.08)';
    b.classList.remove('active');
  });
  btn.style.background = 'var(--moss)';
  btn.classList.add('active');
}

/* ================= QUIZ ENGINE ================= */
let jumpGridOpen = false;
function startSet(questions, title, lessonId){
  currentSet = { title, questions, lessonId, answers: new Array(questions.length).fill(null) };
  currentIndex = 0;
  jumpGridOpen = false;
  document.getElementById('jump-grid').classList.remove('open');
  currentScore = 0;
  switchView('quiz-view', null);
  renderQuestion();
}
function renderQuestion(){
  const q = currentSet.questions[currentIndex];
  answeredCurrent = false;
  document.getElementById('quiz-title-label').textContent = currentSet.title;
  document.getElementById('quiz-count-label').textContent = (currentIndex+1) + ' / ' + currentSet.questions.length;
  document.getElementById('quiz-progress-fill').style.width = Math.round(100*currentIndex/currentSet.questions.length) + '%';
  document.getElementById('q-source').textContent = q.source || '';
  let visualBlock = '';
  if(q.visualSvg){
    visualBlock = `<div style="margin-bottom:16px;">${q.visualSvg}</div>`;
  } else if(q.visualMermaid){
    visualBlock = `<div id="mermaid-holder" style="margin-bottom:16px;background:#F4F1E6;border-radius:4px;padding:12px;"></div>`;
  } else if(q.hasVisual){
    visualBlock = `<span class="visual-flag">⚠ References a ${q.visualNote ? q.visualNote.replace('Yes ','').replace(/[()]/g,'') : 'figure'} not yet added — answer without it for now</span><br>`;
  }
  document.getElementById('q-text').innerHTML = visualBlock + q.text.replace(/</g,'&lt;').replace(/\n/g, '<br>');
  if(q.visualMermaid && window.mermaid){
    const holder = document.getElementById('mermaid-holder');
    const renderId = 'mmd-' + Math.random().toString(36).slice(2);
    mermaid.render(renderId, q.visualMermaid).then(({svg}) => {
      holder.innerHTML = svg;
    }).catch(err => {
      holder.innerHTML = '<span style="color:#B0503A;font-family:monospace;font-size:12px;">Diagram failed to render.</span>';
      console.error('Mermaid render error', err);
    });
  }
  const optsContainer = document.getElementById('options-container');
  optsContainer.innerHTML = '';
  const priorAnswer = currentSet.answers[currentIndex];
  q.options.forEach((opt, i)=>{
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.textContent = opt;
    if(priorAnswer !== null){
      btn.disabled = true;
      if(i === q.answer) btn.classList.add('correct');
      else if(i === priorAnswer) btn.classList.add('incorrect');
    } else {
      btn.onclick = () => selectAnswer(i, btn);
    }
    optsContainer.appendChild(btn);
  });
  const exp = document.getElementById('explanation');
  if(priorAnswer !== null && q.explanation){
    exp.textContent = q.explanation;
    exp.style.display = 'block';
  } else {
    exp.style.display = 'none';
    exp.textContent = '';
  }
  document.getElementById('next-btn').disabled = priorAnswer === null;
  document.getElementById('next-btn').textContent = currentIndex === currentSet.questions.length - 1 ? 'Finish' : 'Next question';
  document.getElementById('prev-btn').disabled = currentIndex === 0;
  renderJumpGrid();
}
function selectAnswer(i, btn){
  if(answeredCurrent) return;
  answeredCurrent = true;
  const q = currentSet.questions[currentIndex];
  const correct = i === q.answer;
  if(correct) currentScore++;
  currentSet.answers[currentIndex] = i;

  document.querySelectorAll('.option').forEach((el, idx)=>{
    el.disabled = true;
    if(idx === q.answer) el.classList.add('correct');
    else if(idx === i) el.classList.add('incorrect');
  });

  const exp = document.getElementById('explanation');
  if(q.explanation){
    exp.textContent = q.explanation;
    exp.style.display = 'block';
  } else {
    exp.style.display = 'none';
  }
  document.getElementById('next-btn').disabled = false;
  document.getElementById('next-btn').textContent = currentIndex === currentSet.questions.length - 1 ? 'Finish' : 'Next question';
  renderJumpGrid();

  // update progress
  userProgress.totalAnswered++;
  if(correct) userProgress.totalCorrect++;
  if(currentSet.lessonId){
    const ls = userProgress.lessonStats[currentSet.lessonId] || {answered:0, correct:0};
    ls.answered++; if(correct) ls.correct++;
    userProgress.lessonStats[currentSet.lessonId] = ls;
  }
  updateUserStat();
}
function nextQuestion(){
  if(currentIndex < currentSet.questions.length - 1){
    currentIndex++;
    renderQuestion();
  }else{
    finishSet();
  }
}
function prevQuestion(){
  if(currentIndex > 0){
    currentIndex--;
    renderQuestion();
  }
}
function goToQuestion(idx){
  currentIndex = idx;
  renderQuestion();
}
function toggleJumpGrid(){
  jumpGridOpen = !jumpGridOpen;
  document.getElementById('jump-grid').classList.toggle('open', jumpGridOpen);
}
function renderJumpGrid(){
  const grid = document.getElementById('jump-grid');
  grid.innerHTML = '';
  currentSet.questions.forEach((q, idx)=>{
    const btn = document.createElement('button');
    btn.className = 'jump-btn';
    btn.textContent = idx + 1;
    const ans = currentSet.answers[idx];
    if(idx === currentIndex) btn.classList.add('jump-current');
    if(ans !== null){
      if(ans === q.answer) btn.classList.add('jump-correct');
      else btn.classList.add('jump-incorrect');
    }
    btn.onclick = () => goToQuestion(idx);
    grid.appendChild(btn);
  });
}
async function finishSet(){
  userProgress.history.push({
    title: currentSet.title,
    score: currentScore,
    total: currentSet.questions.length,
    date: new Date().toISOString()
  });
  await saveProgress(currentUser, userProgress);
  document.getElementById('summary-score').textContent = currentScore + '/' + currentSet.questions.length;
  document.getElementById('summary-title').textContent = currentSet.title;
  switchView('summary-view', null);
}
function backToSets(){
  renderLessons();
  renderTestList('est-old');
  renderTestList('est-new');
  renderTestList('act');
  switchView('biology-view', document.querySelector('.nav-btn'));
}

if(window.mermaid){
  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      primaryColor: '#F4F1E6',
      primaryTextColor: '#16232A',
      primaryBorderColor: '#16232A',
      lineColor: '#16232A',
      secondaryColor: '#EDE7D9',
      tertiaryColor: '#F4F1E6',
      fontFamily: "'IBM Plex Mono', monospace",
      fontSize: '13px'
    }
  });
}

document.getElementById('name-input').addEventListener('keydown', e=>{
  if(e.key === 'Enter') login();
});
</script>
