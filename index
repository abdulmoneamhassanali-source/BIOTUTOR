<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vantage — Biology · EST · ACT Practice</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#16232A;
    --ink-soft:#2C3E44;
    --paper:#EDE7D9;
    --paper-dim:#E2DBC9;
    --cream-text:#F4F1E6;
    --moss:#3F7D5C;
    --moss-dark:#2E5C43;
    --amber:#C98A2C;
    --coral:#B0503A;
    --line:rgba(22,35,42,0.14);
    --line-light:rgba(244,241,230,0.16);
  }
  *{box-sizing:border-box;}
  #site-banner{
    background:var(--ink); color:var(--cream-text);
    font-family:'IBM Plex Mono', monospace; font-size:12.5px; letter-spacing:0.02em;
    text-align:center; padding:9px 16px; line-height:1.5;
    border-bottom:2px solid var(--moss);
  }
  #site-banner .sep{ color:var(--moss); margin:0 8px; }
  #site-banner a{ color:var(--cream-text); text-decoration:underline; text-decoration-color:var(--moss); text-underline-offset:2px; }
  #site-banner a:hover{ color:#fff; text-decoration-color:var(--amber); }
  #site-banner strong{ color:#fff; font-weight:600; }
  #site-banner .cal-link{
    background:none; border:1px solid var(--moss); color:var(--cream-text);
    font-family:'IBM Plex Mono', monospace; font-size:12px; padding:3px 10px;
    border-radius:3px; margin-left:10px; cursor:pointer; vertical-align:middle;
  }
  #site-banner .cal-link:hover{ background:var(--moss); }
  #calendar-modal{
    display:none; position:fixed; inset:0; background:rgba(15,20,18,0.72);
    z-index:1000; align-items:center; justify-content:center; padding:24px;
  }
  #calendar-modal.open{ display:flex; }
  .cal-modal-box{
    background:#fff; border-radius:6px; max-width:820px; width:100%;
    max-height:88vh; display:flex; flex-direction:column; overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,0.4);
  }
  .cal-modal-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 18px; border-bottom:1px solid var(--line); background:var(--paper);
  }
  .cal-modal-tabs{ display:flex; gap:8px; }
  .cal-tab-btn{
    background:transparent; border:1px solid var(--moss); color:var(--moss-dark);
    font-size:13px; font-weight:600; padding:7px 14px; border-radius:3px; cursor:pointer;
  }
  .cal-tab-btn.active{ background:var(--moss); color:#fff; }
  .cal-modal-close{
    background:none; border:none; font-size:24px; line-height:1; color:var(--ink-soft);
    cursor:pointer; padding:0 4px;
  }
  .cal-modal-close:hover{ color:var(--coral); }
  .cal-modal-body{ overflow:auto; padding:18px; background:#f4f4f4; }
  .cal-modal-body svg{ display:block; margin:0 auto; max-width:100%; height:auto; }
  html,body{margin:0;padding:0;height:100%;}
  body{
    background:var(--ink);
    color:var(--cream-text);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  h1,h2,h3{font-family:'Source Serif 4', serif; margin:0; font-weight:600;}
  .mono{font-family:'IBM Plex Mono', monospace;}
  a{color:inherit;}
  button{font-family:inherit; cursor:pointer;}

  /* ---------- LOGIN ---------- */
  #login-screen{
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    padding:24px;
  }
  .login-card{
    max-width:420px; width:100%;
    background:var(--paper); color:var(--ink);
    border-radius:2px; padding:40px 36px;
    border-left:5px solid var(--moss);
  }
  .login-card .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.03em; color:var(--moss-dark); margin-bottom:10px;}
  .login-card h1{font-size:30px; line-height:1.15; margin-bottom:8px;}
  .login-card p{font-size:14.5px; line-height:1.5; color:var(--ink-soft); margin:0 0 22px;}
  .login-card input{
    width:100%; padding:12px 14px; font-size:15px;
    border:1px solid rgba(22,35,42,0.3); border-radius:2px;
    background:#fff; color:var(--ink); margin-bottom:14px;
    font-family:inherit;
  }
  .login-card button{
    width:100%; padding:13px; background:var(--moss); color:#fff;
    border:none; border-radius:2px; font-size:15px; font-weight:600;
    transition:background .15s;
  }
  .login-card button:hover{background:var(--moss-dark);}
  .login-note{font-size:12.5px; color:var(--ink-soft); margin-top:14px; opacity:0.8;}

  /* ---------- APP SHELL ---------- */
  #app{display:none; min-height:100vh; grid-template-columns:240px 1fr;}
  #app.active{display:grid;}
  aside{
    background:#101B20; border-right:1px solid var(--line-light);
    padding:26px 20px; display:flex; flex-direction:column; justify-content:space-between;
  }
  .brand{margin-bottom:34px;}
  .brand .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--moss); letter-spacing:0.03em;}
  .brand h1{font-size:22px; color:var(--cream-text); margin-top:4px;}
  nav button{
    display:block; width:100%; text-align:left; background:none; border:none;
    color:var(--cream-text); opacity:0.65; font-size:14.5px; padding:11px 10px;
    border-radius:3px; margin-bottom:4px; transition:all .15s;
  }
  nav button:hover{opacity:1; background:rgba(244,241,230,0.06);}
  nav button.active{opacity:1; background:rgba(63,125,92,0.22); color:#fff; border-left:3px solid var(--moss); padding-left:8px;}
  .user-box{border-top:1px solid var(--line-light); padding-top:16px; font-size:13px;}
  .user-box .name{font-weight:600; margin-bottom:2px;}
  .user-box .stat{opacity:0.6; font-size:12px;}
  .user-box button{background:none; border:none; color:var(--coral); opacity:0.85; font-size:12.5px; padding:8px 0 0; text-align:left;}

  main{padding:40px 48px; overflow-y:auto; max-height:100vh;}
  .view{display:none;}
  .view.active{display:block;}
  .page-head{margin-bottom:28px; max-width:640px;}
  .page-head .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--moss); margin-bottom:8px;}
  .page-head h2{font-size:28px; color:#fff;}
  .page-head p{color:rgba(244,241,230,0.65); font-size:14.5px; line-height:1.55; margin-top:8px;}

  .lesson-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:14px;}
  .lesson-card{
    background:var(--paper); color:var(--ink); border-radius:2px; padding:18px 20px;
    cursor:pointer; transition:transform .12s; border-bottom:3px solid transparent;
  }
  .lesson-card:hover{transform:translateY(-2px); border-bottom-color:var(--moss);}
  .lesson-card h3{font-size:17px; margin-bottom:6px;}
  .lesson-card .meta{font-size:12.5px; color:var(--ink-soft); font-family:'IBM Plex Mono', monospace;}
  .lesson-card .bar{height:4px; background:var(--paper-dim); border-radius:2px; margin-top:12px; overflow:hidden;}
  .lesson-card .bar-fill{height:100%; background:var(--moss);}

  .test-row{
    display:flex; justify-content:space-between; align-items:center;
    background:var(--paper); color:var(--ink); border-radius:2px;
    padding:16px 20px; margin-bottom:10px;
  }
  .test-row h3{font-size:16px;}
  .test-row .meta{font-size:12.5px; color:var(--ink-soft); font-family:'IBM Plex Mono', monospace; margin-top:2px;}
  .test-row button{background:var(--ink); color:#fff; border:none; padding:9px 18px; border-radius:2px; font-size:13.5px; font-weight:500;}
  .test-row button:hover{background:var(--moss-dark);}

  .empty-hint{
    border:1px dashed rgba(244,241,230,0.25); border-radius:3px; padding:16px 18px;
    font-size:13.5px; color:rgba(244,241,230,0.55); margin-top:18px; max-width:480px; line-height:1.5;
  }

  /* ---------- QUIZ ---------- */
  #quiz-view{max-width:640px;}
  .jump-toggle{
    background:none; border:1px solid var(--line); color:var(--ink-soft);
    font-family:'IBM Plex Mono', monospace; font-size:12px; padding:5px 11px;
    border-radius:3px; cursor:pointer; margin-top:10px;
  }
  .jump-toggle:hover{ border-color:var(--moss); color:var(--moss-dark); }
  #jump-grid{
    display:none; flex-wrap:wrap; gap:6px; margin-top:12px; padding:14px;
    background:var(--paper); border-radius:4px; max-height:220px; overflow-y:auto;
  }
  #jump-grid.open{ display:flex; }
  .jump-btn{
    width:34px; height:34px; border-radius:3px; border:1.5px solid var(--line);
    background:#fff; color:var(--ink-soft); font-family:'IBM Plex Mono', monospace;
    font-size:12.5px; font-weight:600; cursor:pointer; display:flex; align-items:center;
    justify-content:center;
  }
  .jump-btn:hover{ border-color:var(--moss); }
  .jump-btn.jump-current{ border-color:var(--ink); border-width:2px; }
  .jump-btn.jump-correct{ background:var(--moss); border-color:var(--moss); color:#fff; }
  .jump-btn.jump-incorrect{ background:var(--coral); border-color:var(--coral); color:#fff; }
  .quiz-nav-actions{ display:flex; gap:10px; justify-content:flex-end; margin-top:18px; }
  .quiz-nav-actions button{ background:var(--moss); color:#fff; border:none; padding:11px 22px; border-radius:2px; font-size:14px; font-weight:600; }
  .quiz-nav-actions button:disabled{ opacity:0.35; cursor:default; }
  #prev-btn{ background:none; border:1px solid var(--line); color:var(--ink-soft); }
  #prev-btn:hover:not(:disabled){ border-color:var(--moss); color:var(--moss-dark); }
  .quiz-progress{display:flex; justify-content:space-between; align-items:center; margin-bottom:22px; font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:rgba(244,241,230,0.6);}
  .quiz-progress-bar{height:3px; background:rgba(244,241,230,0.15); border-radius:2px; margin-top:6px; overflow:hidden;}
  .quiz-progress-bar-fill{height:100%; background:var(--moss);}
  .q-source{font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:var(--amber); margin-bottom:10px;}
  .q-text{font-size:19px; line-height:1.5; color:#fff; margin-bottom:22px; white-space:pre-line;}
  .visual-flag{display:inline-block; font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--coral); background:rgba(176,80,58,0.12); border:1px solid rgba(176,80,58,0.35); padding:3px 8px; border-radius:2px; margin-bottom:10px;}
  .option{
    display:block; width:100%; text-align:left; background:var(--paper); color:var(--ink);
    border:none; border-radius:2px; padding:14px 16px; margin-bottom:10px; font-size:14.5px;
    transition:background .12s;
  }
  .option:hover{background:var(--paper-dim);}
  .option.correct{background:var(--moss); color:#fff;}
  .option.incorrect{background:var(--coral); color:#fff;}
  .option:disabled{cursor:default;}
  .explanation{
    background:rgba(244,241,230,0.06); border-left:3px solid var(--amber);
    padding:14px 16px; font-size:13.5px; line-height:1.55; color:rgba(244,241,230,0.85);
    margin:16px 0; border-radius:0 2px 2px 0; display:none;
  }
  .quiz-actions{display:flex; justify-content:flex-end; margin-top:8px;}
  .quiz-actions button{background:var(--moss); color:#fff; border:none; padding:11px 22px; border-radius:2px; font-size:14px; font-weight:600;}
  .quiz-actions button:disabled{opacity:0.35; cursor:default;}

  .summary-card{background:var(--paper); color:var(--ink); border-radius:2px; padding:32px; max-width:500px;}
  .summary-card .score{font-family:'Source Serif 4',serif; font-size:52px; font-weight:700; color:var(--moss-dark);}
  .summary-card .label{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--ink-soft); margin-bottom:4px;}
  .summary-card button{margin-top:20px; background:var(--ink); color:#fff; border:none; padding:11px 20px; border-radius:2px; font-size:14px;}

  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-thumb{background:rgba(244,241,230,0.15); border-radius:4px;}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.9.1/mermaid.min.js"></script>
</head>
<body>

<div id="site-banner">
  <strong>ACT/EST BIO COURSE</strong><span class="sep">|</span>Dr. Abdulmoneam Hassan<span class="sep">|</span>Contact: <a href="tel:+966509527148">+966509527148</a>, <a href="tel:+01038690421">+01038690421</a><button class="cal-link" onclick="openCalendarModal()">📅 Exam Dates</button>
</div>

<div id="calendar-modal" onclick="if(event.target.id==='calendar-modal') closeCalendarModal();">
  <div class="cal-modal-box">
    <div class="cal-modal-head">
      <div class="cal-modal-tabs">
        <button class="cal-tab-btn active" id="cal-tab-est" onclick="switchCalendarTab('est')">EST Calendar</button>
        <button class="cal-tab-btn" id="cal-tab-act" onclick="switchCalendarTab('act')">ACT Calendar</button>
      </div>
      <button class="cal-modal-close" onclick="closeCalendarModal()">&times;</button>
    </div>
    <div class="cal-modal-body">
      <div id="cal-panel-est"></div>
      <div id="cal-panel-act" style="display:none;"></div>
    </div>
  </div>
</div>

<div id="login-screen">
  <div class="login-card">
    <div class="eyebrow">PRACTICE PLATFORM</div>
    <h1>Biology, EST &amp; ACT prep</h1>
    <p>Enter your name to start or resume practice. Your progress is saved under this name, so use the same one each time.</p>
    <input id="name-input" type="text" placeholder="Your name" maxlength="40">
    <button onclick="login()">Enter</button>
    <div class="login-note">No password — this is a lightweight practice tool, not a secure login. Pick a name your teacher will recognize.</div>
  </div>
</div>

<div id="app">
  <aside>
    <div>
      <div class="brand">
        <div class="eyebrow">01 · 02 · 03</div>
        <h1>Vantage Prep</h1>
      </div>
      <nav>
        <button class="nav-btn active" data-view="biology-view" onclick="switchView('biology-view', this)">Biology by Lesson</button>
        <button class="nav-btn" data-view="est-view" onclick="switchView('est-view', this)">EST Past Tests</button>
        <button class="nav-btn" data-view="act-view" onclick="switchView('act-view', this)">ACT Past Tests</button>
      </nav>
    </div>
    <div class="user-box">
      <div class="name" id="user-name-display"></div>
      <div class="stat" id="user-stat-display">0 questions answered</div>
      <button onclick="logout()">Switch user</button>
    </div>
  </aside>

  <main>
    <!-- SECTION 1: BIOLOGY -->
    <div class="view active" id="biology-view">
      <div class="page-head">
        <div class="eyebrow">SECTION 1</div>
        <h2>Biology, by lesson</h2>
        <p>Questions here are pulled from the real EST and ACT past tests in Sections 2 and 3, grouped by topic so you can drill one lesson at a time.</p>
      </div>
      <div class="lesson-grid" id="lesson-grid"></div>
      <div class="empty-hint" id="biology-hint">Pulled from the 5 EST (Old) tests provided so far. Some questions reference a figure, graph, or table that hasn't been added yet — those are marked "figure pending" and will be completed once images are provided.</div>
    </div>

    <!-- SECTION 2: EST -->
    <div class="view" id="est-view">
      <div class="page-head">
        <div class="eyebrow">SECTION 2</div>
        <h2>EST — previous real tests</h2>
        <p>Full past EST exams, taken as originally administered. Old and new EST tests are kept separate.</p>
      </div>
      <div style="display:flex; gap:8px; margin-bottom:18px;">
        <button class="subtab-btn active" data-subtab="est-old" onclick="switchEstSubtab('est-old', this)" style="background:var(--moss); color:#fff; border:none; padding:9px 16px; border-radius:2px; font-size:13.5px; font-weight:600;">EST — Old</button>
        <button class="subtab-btn" data-subtab="est-new" onclick="switchEstSubtab('est-new', this)" style="background:rgba(244,241,230,0.08); color:var(--cream-text); border:none; padding:9px 16px; border-radius:2px; font-size:13.5px; font-weight:600;">EST — New</button>
        <button class="subtab-btn" data-subtab="est-lesson" onclick="switchEstSubtab('est-lesson', this)" style="background:rgba(244,241,230,0.08); color:var(--cream-text); border:none; padding:9px 16px; border-radius:2px; font-size:13.5px; font-weight:600;">By Lesson</button>
      </div>
      <div id="est-old-list"></div>
      <div id="est-new-list" style="display:none;"></div>
      <div class="lesson-grid" id="est-lesson-grid" style="display:none;"></div>
      <div class="empty-hint" id="est-hint">5 old EST tests are loaded (400 questions total). Send the new EST tests whenever you're ready and I'll add them under "EST — New" so the two stay separate.</div>
    </div>

    <!-- SECTION 3: ACT -->
    <div class="view" id="act-view">
      <div class="page-head">
        <div class="eyebrow">SECTION 3</div>
        <h2>ACT — previous real tests</h2>
        <p>Full past ACT exams (science/biology-relevant sections), taken as originally administered.</p>
      </div>
      <div style="display:flex; gap:8px; margin-bottom:18px;">
        <button class="subtab-btn active" data-subtab="act-all" onclick="switchActSubtab('act-all', this)" style="background:var(--moss); color:#fff; border:none; padding:9px 16px; border-radius:2px; font-size:13.5px; font-weight:600;">All Tests</button>
        <button class="subtab-btn" data-subtab="act-lesson" onclick="switchActSubtab('act-lesson', this)" style="background:rgba(244,241,230,0.08); color:var(--cream-text); border:none; padding:9px 16px; border-radius:2px; font-size:13.5px; font-weight:600;">By Lesson</button>
      </div>
      <div id="act-list"></div>
      <div class="lesson-grid" id="act-lesson-grid" style="display:none;"></div>
      <div class="empty-hint">No ACT tests loaded yet. Send the past ACT papers whenever you're ready and I'll add each full test here.</div>
    </div>

    <!-- QUIZ VIEW -->
    <div class="view" id="quiz-view">
      <div class="quiz-progress">
        <span id="quiz-title-label"></span>
        <span id="quiz-count-label"></span>
      </div>
      <div class="quiz-progress-bar"><div class="quiz-progress-bar-fill" id="quiz-progress-fill" style="width:0%"></div></div>
      <button class="jump-toggle" onclick="toggleJumpGrid()" id="jump-toggle-btn">≡ Jump to question</button>
      <div id="jump-grid"></div>
      <div style="margin-top:26px;">
        <div class="q-source" id="q-source"></div>
        <div class="q-text" id="q-text"></div>
        <div id="options-container"></div>
        <div class="explanation" id="explanation"></div>
        <div class="quiz-nav-actions">
          <button id="prev-btn" onclick="prevQuestion()">Previous</button>
          <button id="next-btn" onclick="nextQuestion()" disabled>Next question</button>
        </div>
      </div>
    </div>

    <!-- SUMMARY VIEW -->
    <div class="view" id="summary-view">
      <div class="summary-card">
        <div class="label">SET COMPLETE</div>
        <div class="score" id="summary-score">0/0</div>
        <div id="summary-title" style="margin-top:6px; font-size:15px; color:var(--ink-soft);"></div>
        <button onclick="backToSets()">Back</button>
      </div>
    </div>
  </main>
</div>

<script>

const CALENDAR_SVGS = {
  est: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1150" width="100%" height="100%">
